# Copy to loobook/supabase/.env (ignored by git) before running `supabase config push`.
# Password / API key from your email provider (e.g. Resend → API Keys)
SMTP_PASSWORD=
# Sign in with Apple (Apple Developer → Identifiers → Services ID, and a generated client secret)
APPLE_SERVICES_ID=
APPLE_CLIENT_SECRET=
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secrets for the delete-account function, so deleting an account also revokes
# Sign in with Apple (Apple requires this). Set them with:
#   supabase secrets set --env-file supabase/.env
# Apple Developer → Keys → create a key with "Sign in with Apple"; paste the .p8 contents.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.loobook.app
