# Copy to .env.local and fill in. Leave the Supabase values empty to run in demo mode
# (sample data, any login works) — handy for trying the app in Expo Go.

# Supabase project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat (donations / tip jar) → Project settings → API keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob banner ad unit IDs. Leave empty to use Google's test ads.
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=

# Where people email you
EXPO_PUBLIC_SUPPORT_EMAIL=help@example.com
