# Postgres connection string.
# Local:  postgresql://postgres:postgres@localhost:5432/trackwise
# Neon:   postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/trackwise?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trackwise"

# Email. Leave RESEND_API_KEY unset to write messages to .dev-outbox/ instead
# of sending them — useful in development, and safe by default.
RESEND_API_KEY=""
EMAIL_FROM="TrackWise <noreply@trackwise.app>"
