DATABASE_URL="postgresql://postgres:postgres@localhost:5432/redeploy"

# Bullhorn — an agency obtains these from Bullhorn support for their own tenant.
# Leave blank to run on CSV import only.
BULLHORN_CLIENT_ID=""
BULLHORN_CLIENT_SECRET=""

# Email, used for password resets. Leave RESEND_API_KEY unset to write messages
# to .dev-outbox/ instead of sending them — useful in development, and safe by
# default: nothing can email a real recruiter until a provider is configured.
RESEND_API_KEY=""
EMAIL_FROM="Redeploy <noreply@redeploy.app>"
